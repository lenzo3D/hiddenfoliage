# Copy this file to .env.local (which git ignores) and fill in the real values.
# Restart the dev server after changing it. On the hosting service, set the same
# names in its environment-variables settings.

# ── Public address of the site (for absolute links in share cards) ────────────
# e.g. https://hiddenfoliage.sg — no trailing slash. Locally it can stay empty.
NEXT_PUBLIC_SITE_URL=

# ── Enquiries: WhatsApp ────────────────────────────────────────────────────────
# The agent's WhatsApp number in international format, digits only, no "+", no
# spaces (Singapore: 65 followed by the 8-digit number). Leave empty to hide the
# WhatsApp link. NEXT_PUBLIC_ means the value is built into the page — fine here,
# the number is meant to be seen.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# ── Enquiries: email (the form at the end of the film → /api/enquire) ────────
# Sent through Resend (resend.com) — free tier is plenty for a single residence.
# 1. Create a Resend account, add and verify the sending domain, create an API key.
# 2. Fill these in. Several recipients: separate with commas.
RESEND_API_KEY=
ENQUIRY_TO=
# Optional. Must use a domain verified in Resend. If left empty the route uses
# Resend's test sender, which only delivers to the Resend account owner's inbox.
ENQUIRY_FROM=
